  "sampleContentPool": {
    "active": true,
    "sampleContent0": {
      "active": true,
      "value": "%%Hier können ausführliche Informationen zum Medium eingetragen werden. Nachfolgend einige Hinweise zum möglichen Inhalt.%%\n\n"
    },
    "sampleContent1": {
      "active": true,
      "value": "%%**Grunddaten zum Medium**%%\n%%Grunddaten zum Medium behandelt Themen wie:%%\n%%Grunddaten zum Medium, die nicht in den erweiterten Daten erfasst sind.%%*\n\n"
    },
    "sampleContent2": {
      "active": true,
      "value": "%%**Ziel und Kontext:**%%\n%%Ziel und Kontext behandelt Themen wie:%%\n%%*Zweck des Mediums, Zielgruppen, sowie Tonalität und Stilvorgaben (formell, sachlich, aufmerksam, humorvoll)*%%\n\n"
    },
    "sampleContent3": {
      "active": true,
      "value": "%%**Inhaltliche Schwerpunkte:**%%\n%%Inhaltliche Schwerpunkte behandelt Themen wie:%%\n%%*Kernaussagen/These, Hintergrundinformationen, Kontext, Relevantz, Wichtige Zitate und Quellen, sowie Gegenargumente und alternative Perspektiven*%%\n\n"
    },
    "sampleContent4": {
      "active": true,
      "value": "%%**Struktur und Aufbau:**%%\n%%Struktur und Aufbau behandelt Themen wie:%%\n%%*Gliederung, Überschriften, Abstract/Summary sowie, Reihenfolge der Abschnitte (Einleitung, Hintergrund, Details, Auswirkungen)*%%\n\n"
    },
    "sampleContent5": {
      "active": true,
      "value": "%%**Protagonisten und Beteiligte:**%%\n%%Protagonisten und Beteiligte behandelt Themen wie:%%\n%%*Personen, Organisationen, Rollen, Relevante Qualifikationen, Erfahrungen, Standpunkte, sowie Vertraulichkeits- und Einwilligungsstatus*%%\n\n"
    },
    "sampleContent6": {
      "active": true,
      "value": "%%**Daten und Fakten:**%%\n%%Daten und Fakten behandelt Themen wie:%%\n%%*Zahlen, Statistiken, Zeitrahmen, Quellenangaben, Verifizierungsnachweise, Grafiken, Tabellen, sowie Diagramme (Format, Beschriftungen)*%%\n\n"
    },
    "sampleContent7": {
      "active": true,
      "value": "%%**Rechte und Ethik:**%%\n%%Rechte und Ethik behandelt Themen wie:%%\n%%*Urheberrechte, Nutzungsbedingungen, Einwilligungen, Datenschutz (insbesondere bei personenbezogenen Daten), sowie Umgang mit sensiblen Informationen*%%\n\n"
    },
    "sampleContent8": {
      "active": true,
      "value": "%%**Veröffentlichungsdetails:**%%\n%%Veröffentlichungsdetails behandelt Themen wie:%%\n%%*Veröffentlichungsdatum, Zeitfenster, Kanäle (Print, Online, Social, Presseverteiler), Timing-Strategie, sowie Cross-Promotion*%%\n\n"
    },
    "sampleContent9": {
      "active": true,
      "value": "%%**Ansprechpartner:**%%\n%%Ansprechpartner behandelt Themen wie:%%\n%%*Ansprechpartner:in für Rückfragen, Kontaktdaten, Pressesprecher/in, sowie Agenturen*%%\n\n"
    },
    "sampleContent10": {
      "active": true,
      "value": "%%**Formatspezifika:**%%\n%%Formatspezifika behandelt Themen wie:%%\n%%*Länge des Textes, Zitierweise, Stilhandbuch, Anforderungen an Logos, sowie Farbschemata und Layout*%%\n\n"
    },
    "sampleContent11": {
      "active": true,
      "value": "%%**Anhänge und Zusatzmaterial:**%%\n%%Anhänge und Zusatzmaterial behandelt Themen wie:%%\n%%*Hintergrunddokumente, Glossar, Chronologien, sowie Verknüpfungen zu relevanten Ressourcen*%%\n\n"
    },
    "sampleContent12": {
      "active": true,
      "value": "%%**Hinweise zur Anwendung:**%%\n%%Passe Details an Kanal, Zielgruppe und Rechtsrahmen an. Prüfe Datenschutz und Quellenverifikation. Halte die Beschreibung konsistent, klar und objektiv.%%\n"
    }
  }
