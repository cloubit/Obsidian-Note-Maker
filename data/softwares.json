    "sampleContent0": {
      "active": true,
      "value": "%%Hier können ausführliche Informationen zur Software eingetragen werden. Nachfolgend einige Hinweise zum möglichen Inhalt.%%\n\n"
    },
    "sampleContent1": {
      "active": true,
      "value": "%%**Produktübersicht**%%\n%%WProduktübersicht behandelt Themen wie:%%\n%%*Name, Version, Zweck und Hauptnutzen, Zielgruppe und Einsatzzenarien, die nicht in den erweiterten Daten erfasst sind%%\n\n"
    },
    "sampleContent2": {
      "active": true,
      "value": "%%**Funktionale Anforderungen:**%%\n%%Funktionale Anforderungen behandelt Themen wie:%%\n%%*Hauptfunktionen und Anwendungsfälle, Arbeitsabläufe (User Journeys) und Screenshots/Mockups, Abhängigkeiten*%%\n\n"
    },
    "sampleContent3": {
      "active": true,
      "value": "%%**Nicht-funktionale Anforderungen:**%%\n%%Nicht-funktionale Anforderungen behandelt Themen wie:%%\n%%*Leistung, Skalierbarkeit, Verfügbarkeit, Sicherheit (Zugriffsrechte, Verschlüsselung, Compliance), Zuverlässigkeit, Backup und Wiederherstellung*%%\n\n"
    },
    "sampleContent4": {
      "active": true,
      "value": "%%**Technische Details:**%%\n%%Technische Details behandelt Themen wie:%%\n%%*Architekturübersicht (Client-Server, Microservices, Monolith), Technologien, Programmiersprachen, Frameworks, Schnittstellen (APIs, Integrationen, Webhooks), Datenmodell (Datenbanken, Schlüsselentitäten, Beziehungen), Installations- und Konfigurationsanleitung, Systemanforderungen (Ressourcen, Abhängigkeiten)*%%\n\n"
    },
    "sampleContent5": {
      "active": true,
      "value": "%%**Sicherheit und Datenschutz:**%%\n%%Sicherheit und Datenschutz behandelt Themen wie:%%\n%%*Authentifizierung/Autorisierung, Rollen, Audit Logs, Umgang mit sensiblen Daten, Datenhoheit, Datenschutz-Konformität*%%\n\n"
    },
    "sampleContent6": {
      "active": true,
      "value": "%%**Benutzeroberfläche und UX:**%%\n%%Benutzeroberfläche und UX behandelt Themen wie:%%\n%%*Designprinzipien, Barrierefreiheit (z. B. WCAG), Konfigurierbare Einstellungen, Personalisierung*%%\n\n"
    },
    "sampleContent7": {
      "active": true,
      "value": "%%**Betrieb und Wartung:**%%\n%%Betrieb und Wartung behandelt Themen wie:%%\n%%*Installations-/Upgrade-Anleitung, Migrationspfade, Logging, Monitoring, Fehlerbehandlung, Backup, Wiederherstellung, Disaster Recovery*%%\n\n"
    },
    "sampleContent8": {
      "active": true,
      "value": "%%**Skalierung und Deployment:**%%\n%%Skalierung und Deployment behandelt Themen wie:%%\n%%*Bereitstellungsmodelle (On-Premise, Cloud, SaaS), CI/CD, Release-Zyklen, Rolling Updates, Lizenzierung und Kosten*%%\n\n"
    },
    "sampleContent9": {
      "active": true,
      "value": "%%**Sicherheitshinweise und Compliance:**%%\n%%Sicherheitshinweise und Compliance behandelt Themen wie:%%\n%%*Datenschutz, Hotfix-Verfahren, Patch-Management*%%\n\n"
    },
    "sampleContent10": {
      "active": true,
      "value": "%%**Migration und Kompatibilität:**%%\n%%Migration und Kompatibilität behandelt Themen wie:%%\n%%*Updatepfade, Abwärts-/Aufwärtskompatibilität, Entfernte Funktionen / Deprecations*%%\n\n"
    },
    "sampleContent11": {
      "active": true,
      "value": "%%**Dokumentation und Support:**%%\n%%Dokumentation und Support behandelt Themen wie:%%\n%%*Benutzerhandbücher, Entwicklerdokumentation, API-Dokumentation, Support-Optionen, Kontaktwege*%%\n\n"
    },
    "sampleContent12": {
      "active": true,
      "value": "%%**Beispiele und Anwendungsnachweise:**%%\n%%Beispiele und Anwendungsnachweise behandelt Themen wie:%%\n%%*Use Case-Beispiele, Beispiel-Daten, Demos, Referenzen/Case Studies*%%\n\n"
    },
    "sampleContent13": {
      "active": true,
      "value": "%%**Rechtliche Hinweise:**%%\n%%Rechtliche Hinweise behandelt Themen wie:%%\n%%*Lizenzbedingungen, geistiges Eigentum, Nutzungsbedingungen*%%\n\n"
    },
    "sampleContent14": {
      "active": true,
      "value": "%%**Anhänge:**%%\n%%Anhänge behandelt Themen wie:%%\n%%*Glossar, Tabellen, API-Spezifikationen, Datenmodelle*%%\n\n"
    },
    "sampleContent15": {
      "active": true,
      "value": "%%**Hinweise zur Anwendung:**%%\n%%Passe Details an Kanal, Zielgruppe und Rechtsrahmen an. Prüfe Datenschutz und Quellenverifikation. Halte die Beschreibung konsistent, klar und objektiv.%%\n"
